pipeline{
    tools{
        maven 'myMaven'
    }
    agent any
        stages{
            stage ("checkout code") {
                steps{
                    git 'https://github.com/Sravani-Meduri/dockerwebapp.git'
                }
            }
            stage ("Build the code") {
                steps{
                    sh 'mvn clean install'
                }
            }
          stage('CQA') {
    steps {
        withSonarQubeEnv(
            installationName: 'mySonar',
            credentialsId: 'sonarid'
        ) {
            sh '''
                mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:5.8.0.7211:sonar \
                  -Dsonar.projectKey=myProject \
                  -Dsonar.projectName="myProject" \
                  -Dsonar.host.url=http://13.53.44.182:9000 \
                  -Dsonar.token="$SONAR_AUTH_TOKEN"
            '''
        }
    }
}

stage ("Quality Gates") {
    steps {
        waitForQualityGate abortPipeline: true
    }
}
stage ("Artifacts"){
    steps{
        nexusArtifactUploader artifacts: [[artifactId: 'vprofile', classifier: '', file: 'target/vprofile-v2.war', type: 'war']], credentialsId: 'nexusid', groupId: 'com.visualpathit', nexusUrl: '16.192.147.175:8081/', nexusVersion: 'nexus3', protocol: 'http', repository: 'myrepo', version: 'v2'
    }
}
stage("create docker images") {
    steps {
        sh '''
            cp target/vprofile-v2.war Docker-app/target/vprofile-v2.war
            docker build -t app-image:v1 Docker-app/
            docker build -t db-image:v1 Docker-db/
        '''
    }
}
stage("Trivy Scan") {
    steps {
        sh '''
            trivy image app-image:v1
            trivy image db-image:v1
        '''
    }
stage("Push to registry"){
             steps{
                 script{
                     withDockerRegistry(credentialsId: 'HubID') {
                        sh 'docker tag app-image:v1 sravanif5/flm-oct:javaaapp'
                        sh 'docker tag db-image:v1 sravanif5/flm-oct:db'
                        sh 'docker push sravanif5/flm-oct:javaapp'
                        sh 'docker push sravanif5/flm-oct:db'
                     }
                     
                 }
             }
         }
}
stage("Deploy using stack"){
    steps{
        sh 'docker stack deploy myapp --comopose-file=compose.yml'
    }
}
    }
}
